{
    "functions": {
        "**/*.php": {
            "runtime": "vercel-php@0.7.0"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ],
    "env": {
        "MYSQLHOST": "@mysqlhost",
        "MYSQLUSER": "@mysqluser", 
        "MYSQLPASSWORD": "@mysqlpassword",
        "MYSQLDATABASE": "@mysqldatabase",
        "MYSQLPORT": "@mysqlport"
    }
}