{
    "functions": {
        "**/*.php": {
            "runtime": "vercel-php@0.7.0"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ],
    "env": {
        "MYSQLHOST": "$DB_HOST",
        "MYSQLUSER": "$DB_USER", 
        "MYSQLPASSWORD": "$DB_PASS",
        "MYSQLDATABASE": "$DB_NAME",
        "MYSQLPORT": "$DB_PORT"
    }
}